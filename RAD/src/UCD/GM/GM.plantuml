@startuml
left to right direction
skinparam packageStyle rectangle

actor "ATT_ADM\n(Amministratore)" as ADM

rectangle "Gestione Moderazione (GM)" {
  usecase "UC_GM_1\nAccesso all'area riservata" as UC1
  usecase "UC_GM_2\nUscita dall'area riservata" as UC2
  usecase "UC_GM_3\nRimozione utente" as UC3
  usecase "UC_GM_4\nRimozione contenuto" as UC4
  usecase "UC_GM_5\nGestione segnalazioni" as UC5
  usecase "UC_GM_6\nGestione richiesta\ndi verifica" as UC6
}

ADM --- UC1
ADM --- UC2
ADM --- UC3
ADM --- UC4
ADM --- UC5
ADM --- UC6

UC4 .> UC5 : <<extend>>
@enduml