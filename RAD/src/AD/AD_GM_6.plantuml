@startuml
|Amministratore (ATT_ADM)|
start
:Clicca su "Richieste di verifica";

|Sistema|
:Recupera le richieste in attesa;

if (Richieste in attesa?) then (No)
  :Mostra messaggio che informa che\nnon ci sono richieste in attesa;
  stop
else (Sì)
endif

repeat
  :Mostra l'elenco delle richieste\n(username, motivazione, "Approva" e "Rifiuta");

  |Amministratore (ATT_ADM)|
  :Clicca su "Approva" oppure "Rifiuta"\nsu una richiesta;

  |Sistema|
  :Chiede di confermare l'operazione;

  |Amministratore (ATT_ADM)|
  :Clicca su "Conferma" oppure "Annulla";

  |Sistema|
backward :Non modifica la richiesta;
repeat while (Operazione confermata?) is (No) not (Sì)

:Tenta il salvataggio della valutazione;

if (Salvataggio riuscito?) then (No)
  :Mostra messaggio di errore\ne invita a ritentare l'operazione;
  :Mantiene la richiesta tra quelle in attesa;
  stop
else (Sì)
  :Aggiorna lo stato della richiesta\ne assegna il verificato (se approvata);
  :Rimuove la richiesta dall'elenco\ne aggiorna l'elenco;
  stop
endif
@enduml