@startuml
hide footbox
skinparam style strictuml
skinparam sequenceMessageAlign center

actor ATT_VIS
participant "RicercaForm" as A <<boundary>>
actor "ATT_API" as API

ATT_VIS -> A : fillForm()
activate A
ATT_VIS -> A : selectFilter()
ATT_VIS -> A : submit()

create participant "RicercaControl" as C <<control>>
A --> C ++ : <<create>>
deactivate A

C -> API ++ : searchContent()
API --> C : content
deactivate API

create participant "ContenutoMusicale" as D <<entity>>
C --> D : <<create>>

create participant "RisultatiContenutiView" as E <<boundary>>
C --> E : <<create>>

C -> D !! : <<destroy>>
deactivate C
@enduml