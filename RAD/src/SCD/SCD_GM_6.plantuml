@startuml
skinparam monochrome true
skinparam shadowing false
skinparam nodesep 25
skinparam ranksep 25
skinparam ArrowThickness 1.5
skinparam state {
  BorderThickness 2
}

[*] --> RecuperaRichieste : press

RecuperaRichieste --> MostraNessunaRichiesta : [nessuna]
RecuperaRichieste --> MostraElenco : [presenti]

MostraNessunaRichiesta --> [*]

MostraElenco --> ChiediConferma : [approva]/[rifiuta]
ChiediConferma --> MostraElenco : [annulla]
ChiediConferma --> AggiornaStato : [conferma]

AggiornaStato --> MostraErrore : [errore]
AggiornaStato --> RecuperaRichieste : [riuscito]

MostraErrore --> [*]
@enduml