@startuml
skinparam monochrome true
skinparam shadowing false
skinparam nodesep 25
skinparam ranksep 25
skinparam ArrowThickness 1.5
skinparam state {
  BorderThickness 2
}

[*] --> RichiesteRicevute : create

RichiesteRicevute --> NessunaRichiesta : [nessuna]
RichiesteRicevute --> ElencoRicevuto : [presenti]

NessunaRichiesta --> [*] : destroy

ElencoRicevuto --> ConfermaAzione : [approva]
ElencoRicevuto --> ConfermaAzione : [rifiuta]
ConfermaAzione --> ElencoRicevuto : [annulla]
ConfermaAzione --> StatoSalvato : [conferma]

StatoSalvato --> Errore : [errore]
StatoSalvato --> RichiesteRicevute : [riuscito]

Errore --> [*] : destroy
@enduml