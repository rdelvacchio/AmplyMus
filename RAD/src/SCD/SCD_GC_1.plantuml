@startuml
skinparam monochrome true
skinparam shadowing false
skinparam nodesep 50
skinparam ranksep 50
skinparam ArrowThickness 1.5
skinparam state {
  BorderThickness 2
}

[*] --> ControlloCampo : avvia ricerca

ControlloCampo --> CampoVuoto : [vuoto]
ControlloCampo --> ContenutiRicevuti : [contenuti musicali]
ControlloCampo --> UtentiRicevuti : [utenti]

ContenutiRicevuti --> NessunRisultato : [nessuno]
ContenutiRicevuti --> RisultatiMostrati : [presenti]
ContenutiRicevuti --> ServizioNonDisponibile : [apiNonDisponibile]

UtentiRicevuti --> NessunRisultato : [nessuno]
UtentiRicevuti --> RisultatiMostrati : [presenti]

CampoVuoto --> [*] : destroy
ServizioNonDisponibile --> [*] : destroy
NessunRisultato --> [*] : destroy
RisultatiMostrati --> [*] : destroy
@enduml