@startuml
skinparam monochrome true
skinparam shadowing false
skinparam nodesep 50
skinparam ranksep 50
skinparam ArrowThickness 1.5
skinparam state {
  BorderThickness 2
}

[*] --> ControlloCampo : avvia ricerca

ControlloCampo --> CampoVuoto : [vuoto]
ControlloCampo --> RicercaContenuti : [contenuti musicali]
ControlloCampo --> RicercaUtenti : [utenti]

RicercaContenuti --> NessunRisultato : [nessuno]
RicercaContenuti --> RisultatiMostrati : [presenti]
RicercaContenuti --> ServizioNonDisponibile : [apiNonDisponibile]

RicercaUtenti --> NessunRisultato : [nessuno]
RicercaUtenti --> RisultatiMostrati : [presenti]

CampoVuoto --> [*]
ServizioNonDisponibile --> [*]
NessunRisultato --> [*]
RisultatiMostrati --> [*] 
@enduml