@startuml
skinparam shadowing false
skinparam linetype polyline
skinparam nodesep 50
skinparam ranksep 50
skinparam rectangle {
  BorderThickness 2
  RoundCorner 0
  BackgroundColor white
  BorderColor black
}
top to bottom direction

circle " " as S #black

rectangle "Home\n(Seguiti / Scopri)" as Home
rectangle "Risultati ricerca" as Ris
rectangle "Profilo utente\n(con badge)" as Prof
rectangle "Artista" as Art
rectangle "Album" as Alb
rectangle "Brano" as Bra
rectangle "Scrivi / Modifica\nrecensione" as Rec
rectangle "Modifica profilo" as ModP
rectangle "Statistiche" as Stat
rectangle "Le mie liste" as Liste
rectangle "Crea lista" as Crea
rectangle "Dettaglio / Modifica\nlista" as DetL
rectangle "Preferiti" as Pref

S --> Home
Home <--> Ris
Home <--> Prof
Ris <--> Prof
Ris <--> Art
Ris <--> Alb
Ris <--> Bra
Art <--> Alb
Alb <--> Bra
Art <--> Bra
Art <--> Rec
Alb <--> Rec
Bra <--> Rec
Prof <--> ModP

Prof <--> Stat
Prof <--> Liste
Prof <--> Pref
Liste <--> Crea
Liste <--> DetL
DetL <--> Ris

@enduml