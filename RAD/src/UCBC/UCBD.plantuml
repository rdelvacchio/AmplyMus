@startuml
left to right direction
skinparam packageStyle rectangle

actor "ATT_ADM\n(Amministratore)" as ADM
actor "ATT_API" as API

rectangle "Boundary Conditions (UCBC)" {
  usecase "UCBC_1\nAvvio del Sistema" as UC1
  usecase "UCBC_2\nSpegnimento del Sistema" as UC2
  usecase "UCBC_3\nIndisponibilità di ATT_API" as UC3
  usecase "UCBC_4\nFallimento del Sistema" as UC4
  usecase "UCBC_5\nErrore dei dati persistenti" as UC5
}

ADM --- UC1
ADM --- UC2
ADM --- UC4
ADM --- UC5

API --- UC1
API --- UC3
@enduml