@startuml
[*] --> CreazioneForm : richiesta scrittura recensione

CreazioneForm --> ValidaDati : invio form

ValidaDati --> ErroreCampi : [dati incompleti]
ErroreCampi --> CreazioneForm : [form aggiornato]

ValidaDati --> SalvaRecensione : [dati validi]

SalvaRecensione --> ErroreSistema : [errore]
SalvaRecensione --> RecensionePubblicata : [successo]

ErroreSistema -->  [*] : destroy
RecensionePubblicata --> [*] : destroy
@enduml