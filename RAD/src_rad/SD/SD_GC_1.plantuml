@startuml
hide footbox
skinparam style strictuml
skinparam sequenceMessageAlign center

actor ATT_VIS
participant "RicercaForm" as A <<boundary>>
participant "RicercaControl" as C <<control>>
participant "RisultatiContenutiView" as B <<boundary>>
actor "ATT_API" as API

ATT_VIS -> A ++: fillForm()
ATT_VIS -> A : selectFilter()
ATT_VIS -> A : submit()

create C
A --> C -- : <<create>>
activate C


C -> API  : searchContent()
activate API
API --> C : content
deactivate API

create B
C --> B : <<create>>

deactivate C
@enduml

